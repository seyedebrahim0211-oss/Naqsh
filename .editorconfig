root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space

[*.{cs,xaml}]
indent_size = 4

[*.{csproj,props,targets,resx,json,yml}]
indent_size = 2

[*.cs]
# Localization is enforced by Naqsh.Localization.Tests (resource parity + no hard-coded UI text).
dotnet_diagnostic.CA1303.severity = none
# Interop and engine types intentionally expose arrays/handles.
dotnet_diagnostic.CA1819.severity = suggestion

[tests/**.cs]
# Test method names use underscores for readability.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2007.severity = none
