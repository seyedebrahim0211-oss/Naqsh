<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Naqsh.Engine</AssemblyName>
    <RootNamespace>Naqsh.Engine.Host</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Naqsh.Engine\Naqsh.Engine.csproj" />
    <ProjectReference Include="..\Naqsh.Inputs\Naqsh.Inputs.csproj" />
    <ProjectReference Include="..\Naqsh.Outputs\Naqsh.Outputs.csproj" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>
