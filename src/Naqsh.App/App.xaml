<Application x:Class="Naqsh.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Naqsh.App.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Colors.xaml" />
                <ResourceDictionary Source="Theme/Ornament.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <c:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <c:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
            <c:MsToSecondsConverter x:Key="MsToSeconds" />
            <c:EqualsConverter x:Key="Equals" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
