<Window x:Class="Naqsh.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Naqsh.App.Localization"
        Style="{StaticResource Window.Base}"
        Title="{loc:Loc Settings_Title}"
        FlowDirection="{loc:LocFlow}"
        Width="620" Height="720" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- Dialog header with ornament -->
        <Grid DockPanel.Dock="Top" Height="56" Background="{StaticResource Brush.Bg.Panel}">
            <Rectangle Fill="{StaticResource Brush.Girih}" />
            <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                <Image Source="{StaticResource Image.Khatam}" Width="28" Height="28" />
                <TextBlock Text="{loc:Loc Settings_Title}" Style="{StaticResource Text.Heading}" Margin="10,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Button DockPanel.Dock="Bottom" Content="{loc:Loc Common_Close}" HorizontalAlignment="Right" Margin="20,8,20,16" MinWidth="100" Click="OnClose" IsCancel="True" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16">
                <TextBlock Text="{loc:Loc Settings_Language}" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                <UniformGrid Columns="2" Margin="0,0,0,16">
                    <RadioButton x:Name="LangFa" GroupName="Lang" Content="{loc:Loc Lang_Persian}" Margin="0,0,4,0" Checked="OnChanged" />
                    <RadioButton x:Name="LangEn" GroupName="Lang" Content="{loc:Loc Lang_English}" Margin="4,0,0,0" Checked="OnChanged" />
                </UniformGrid>

                <TextBlock Text="{loc:Loc Settings_Digits}" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <RadioButton x:Name="DigitsFollow" GroupName="Digits" Content="{loc:Loc Digits_Follow}" Margin="0,0,4,0" Checked="OnChanged" />
                    <RadioButton x:Name="DigitsFa" GroupName="Digits" Content="{loc:Loc Digits_Persian}" Margin="4,0" Checked="OnChanged" />
                    <RadioButton x:Name="DigitsLatin" GroupName="Digits" Content="{loc:Loc Digits_Latin}" Margin="4,0,0,0" Checked="OnChanged" />
                </UniformGrid>

                <TextBlock Text="{loc:Loc Settings_Calendar}" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <RadioButton x:Name="CalFollow" GroupName="Cal" Content="{loc:Loc Calendar_Follow}" Margin="0,0,4,0" Checked="OnChanged" />
                    <RadioButton x:Name="CalJalali" GroupName="Cal" Content="{loc:Loc Calendar_Jalali}" Margin="4,0" Checked="OnChanged" />
                    <RadioButton x:Name="CalGregorian" GroupName="Cal" Content="{loc:Loc Calendar_Gregorian}" Margin="4,0,0,0" Checked="OnChanged" />
                </UniformGrid>

                <CheckBox x:Name="Clock24" Content="{loc:Loc Settings_Clock24}" Margin="0,0,0,16" Checked="OnChanged" Unchecked="OnChanged" />

                <TextBlock Text="{loc:Loc Settings_RecordingFolder}" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                <DockPanel Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Content="{loc:Loc Settings_Browse}" Click="OnBrowse" Margin="8,0,0,0" />
                    <Border Background="{StaticResource Brush.Bg.Raised}" CornerRadius="4" Padding="8,4" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                        <TextBlock x:Name="FolderText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Border>
                </DockPanel>

                <TextBlock Text="{loc:Loc Settings_Format}" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                <TextBlock x:Name="FormatLocked" Text="{loc:Loc Settings_Format_Locked}" Foreground="{StaticResource Brush.Accent.Gold}" FontSize="12" Margin="0,0,0,6" Visibility="Collapsed" />
                <ListBox x:Name="Formats" Height="200" FlowDirection="LeftToRight" SelectionChanged="OnFormatSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ShortName}" Padding="4,2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
