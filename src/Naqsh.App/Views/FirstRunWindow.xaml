<Window x:Class="Naqsh.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Naqsh.App.Localization"
        Style="{StaticResource Window.Base}"
        Title="{loc:Loc FirstRun_Title}"
        FlowDirection="{loc:LocFlow}"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel>
        <!-- Header: girih field + logo -->
        <Grid Height="140" Background="{StaticResource Brush.Bg.Panel}">
            <Rectangle Fill="{StaticResource Brush.Girih}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{StaticResource Image.Khatam}" Width="56" Height="56" />
                <TextBlock Text="{loc:Loc App_Name}" FontFamily="{StaticResource Font.Brand}" FontSize="34"
                           Foreground="{StaticResource Brush.Accent.Gold}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <StackPanel Margin="32,24,32,28">
            <TextBlock Text="{loc:Loc FirstRun_Title}" Style="{StaticResource Text.Heading}" FontSize="22" />
            <TextBlock Text="{loc:Loc FirstRun_Subtitle}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,20" />

            <TextBlock Text="{loc:Loc FirstRun_Language}" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
            <UniformGrid Columns="2" Margin="0,0,0,20">
                <RadioButton x:Name="Persian" GroupName="Lang" Content="{loc:Loc Lang_Persian}" MinHeight="44" FontSize="16" Margin="0,0,4,0" Checked="OnLanguageChecked" />
                <RadioButton x:Name="English" GroupName="Lang" Content="{loc:Loc Lang_English}" MinHeight="44" FontSize="16" Margin="4,0,0,0" Checked="OnLanguageChecked" />
            </UniformGrid>

            <TextBlock Text="{loc:Loc FirstRun_Region}" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
            <StackPanel Margin="0,0,0,4">
                <RadioButton x:Name="Pal" GroupName="Region" Content="{loc:Loc Region_Pal50}" MinHeight="40" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" />
                <RadioButton x:Name="Ntsc" GroupName="Region" Content="{loc:Loc Region_Ntsc60}" MinHeight="40" HorizontalContentAlignment="Stretch" />
            </StackPanel>
            <TextBlock Text="{loc:Loc FirstRun_Region_Hint}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,0,0,24" />

            <Button Style="{StaticResource Btn.Gold}" Content="{loc:Loc FirstRun_Start}" MinHeight="44" FontSize="16" Click="OnStart" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
