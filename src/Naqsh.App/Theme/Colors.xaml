<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colour tokens from docs/DESIGN.md (dark theme, default). Keys mirror the token names. -->
    <Color x:Key="bg.base">#0B1626</Color>
    <Color x:Key="bg.panel">#10203A</Color>
    <Color x:Key="bg.raised">#1C3352</Color>
    <Color x:Key="bg.monitor">#050B14</Color>
    <Color x:Key="border">#2A4A6E</Color>
    <Color x:Key="text.primary">#F1E8D6</Color>
    <Color x:Key="text.secondary">#B7C3D4</Color>
    <Color x:Key="accent.turquoise">#2BB3A6</Color>
    <Color x:Key="accent.gold">#E0A93B</Color>
    <Color x:Key="tally.program">#C8323F</Color>
    <Color x:Key="tally.program.fill">#B3263A</Color>
    <Color x:Key="tally.preview">#3FAE6B</Color>
    <Color x:Key="tally.preview.fill">#2E8A55</Color>

    <SolidColorBrush x:Key="Brush.Bg.Base" Color="{StaticResource bg.base}" />
    <SolidColorBrush x:Key="Brush.Bg.Panel" Color="{StaticResource bg.panel}" />
    <SolidColorBrush x:Key="Brush.Bg.Raised" Color="{StaticResource bg.raised}" />
    <SolidColorBrush x:Key="Brush.Bg.Monitor" Color="{StaticResource bg.monitor}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource border}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource text.primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource text.secondary}" />
    <SolidColorBrush x:Key="Brush.Accent.Turquoise" Color="{StaticResource accent.turquoise}" />
    <SolidColorBrush x:Key="Brush.Accent.Gold" Color="{StaticResource accent.gold}" />
    <SolidColorBrush x:Key="Brush.Tally.Program" Color="{StaticResource tally.program}" />
    <SolidColorBrush x:Key="Brush.Tally.Program.Fill" Color="{StaticResource tally.program.fill}" />
    <SolidColorBrush x:Key="Brush.Tally.Preview" Color="{StaticResource tally.preview}" />
    <SolidColorBrush x:Key="Brush.Tally.Preview.Fill" Color="{StaticResource tally.preview.fill}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#0B1626" />
</ResourceDictionary>
