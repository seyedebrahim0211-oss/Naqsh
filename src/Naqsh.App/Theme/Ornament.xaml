<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Original ornament for Naqsh (docs/DESIGN.md "Ornament").
        Girih band: an 8-point star (two overlapping squares) linked by rotated squares,
        tiled at low opacity. Used only in the header, dialog headers and empty states.
    -->
    <DrawingBrush x:Key="Brush.Girih" TileMode="Tile" Viewport="0,0,36,36" ViewportUnits="Absolute"
                  Viewbox="0,0,36,36" ViewboxUnits="Absolute" Stretch="None" Opacity="0.16">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource Brush.Accent.Gold}" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <!-- 8-point star centred at 18,18 -->
                            <RectangleGeometry Rect="10,10,16,16" />
                            <RectangleGeometry Rect="10,10,16,16">
                                <RectangleGeometry.Transform>
                                    <RotateTransform Angle="45" CenterX="18" CenterY="18" />
                                </RectangleGeometry.Transform>
                            </RectangleGeometry>
                            <!-- rotated squares at the tile corners link neighbouring stars -->
                            <PathGeometry Figures="M0,4 L4,0 M32,0 L36,4 M36,32 L32,36 M4,36 L0,32" />
                            <PathGeometry Figures="M18,0 L18,4.7 M18,31.3 L18,36 M0,18 L4.7,18 M31.3,18 L36,18" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Brush.Accent.Turquoise}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="18,18" RadiusX="1.6" RadiusY="1.6" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Khatam mark: two overlapping gold squares with a turquoise centre. -->
    <DrawingImage x:Key="Image.Khatam">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource Brush.Accent.Gold}" Thickness="2.2" LineJoin="Miter" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="6,6,20,20" />
                            <RectangleGeometry Rect="6,6,20,20">
                                <RectangleGeometry.Transform>
                                    <RotateTransform Angle="45" CenterX="16" CenterY="16" />
                                </RectangleGeometry.Transform>
                            </RectangleGeometry>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Brush.Accent.Turquoise}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="16,16" RadiusX="4" RadiusY="4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
